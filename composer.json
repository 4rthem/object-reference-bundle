{
    "name": "arthem/object-reference-bundle",
    "description": "Object reference bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "doctrine/orm": "^2.5 || ^3",
        "doctrine/doctrine-bundle": "^2.9 || ^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.1.3",
        "friendsofphp/php-cs-fixer": "^v3.58.1",
        "ramsey/uuid": "^4.7"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Arthem\\ObjectReferenceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arthem\\ObjectReferenceBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "cs": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff"
    }
}
